# Salin file ini jadi ".env.local" untuk development lokal, lalu isi dengan
# config Firebase Web App kalian (lihat PANDUAN_OPERATOR_GUDANG.md).
# Untuk deploy di Vercel, isi nilai yang sama di:
#   Project Settings -> Environment Variables (bukan di file ini).
#
# Nilai-nilai ini config publik Firebase Web SDK, BUKAN rahasia/API secret --
# aman ikut ter-bundle ke JS yang dikirim ke browser. Keamanan datanya diatur
# lewat Firestore Security Rules (lihat panduan), bukan dengan menyembunyikan
# nilai-nilai berikut.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# String rahasia bebas (boleh generate sendiri, mis. lewat
# https://www.uuidgenerator.net/) yang dicocokkan di Firestore Security Rules
# supaya collection "manifests" tidak bisa ditulis sembarang orang/bot yang
# kebetulan tahu nama collection-nya. WAJIB nilainya SAMA PERSIS dengan yang
# ditulis di rule "request.resource.data.appToken == '...'" pada Firestore.
VITE_APP_WRITE_TOKEN=
